# Local GitHub MVP - environment contract
#
# Copy to `.env` and fill in real values. Every variable consumed by the app,
# Compose stack, or validation harness is documented here. Placeholders below
# are SAFE LOCAL VALUES ONLY - never commit real tokens, passwords, or secrets.
# See docs/IMPL_PLAN.md "Environment names" for the canonical list.

# --- Runtime -------------------------------------------------------------
# Development ("development") or production ("production").
NODE_ENV=development

# Public base URL of the application (what the browser / Caddy sees).
APP_BASE_URL=http://localhost:8080

# Timezone used for server-side time (deadline checks, audit timestamps).
TZ=UTC

# --- Database (Task B consumes) ------------------------------------------
# SQLite connection string. Path is inside the app's named volume.
# The file is created by the migration runner; do not hand-edit it.
DATABASE_URL=file:/data/studyapp/studyapp.db

# --- Sessions (Task C consumes) ------------------------------------------
# Secret used to sign server sessions. MUST be at least 32 random chars in any
# real deployment. Use `openssl rand -hex 32` to generate a value.
SESSION_SECRET=replace-with-32-random-bytes

# --- Gitea -----------------------------------------------------------------
# Base URL the APP uses to reach Gitea (docker-internal name is "gitea").
GITEA_BASE_URL=http://gitea:3000
# Ports Gitea exposes (for direct debugging / the validation harness).
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
# Admin API token. Create one as the Gitea admin and put it ONLY here / in .env.
# NEVER write this to test evidence or audit payloads.
GITEA_ADMIN_TOKEN=replace-with-admin-api-token
# OAuth2 application registered against Gitea for single sign-on.
GITEA_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GITEA_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# --- Reverse proxy ---------------------------------------------------------
# Host ports Caddy binds for HTTP (and HTTPS where configured).
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443

# --- Mail (SMTP) - optional for local dev ---------------------------------
SMTP_HOST=smtp.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@local-github.local

# --- Notifications (Telegram Bot API) - optional --------------------------
TELEGRAM_BOT_TOKEN=

# --- Test worker (Task for Python execution isolation) --------------------
# URL of the isolated test worker that executes student code.
TEST_WORKER_URL=http://test-worker:8000
