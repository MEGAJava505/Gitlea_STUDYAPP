{
  "name": "local-github-studyapp",
  "version": "0.1.0",
  "private": true,
  "description": "Local GitHub MVP - Phase 0/1 scaffold (Next.js foundation, Gitea stack, validation harness)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint && eslint . --ext .ts,.tsx",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "validate:gitea": "tsx scripts/phase0/run-positive.ts",
    "validate:gitea:negative": "tsx scripts/phase0/run-negative.ts"
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.39.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
